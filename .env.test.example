# QA / test environment — copy to .env.test and fill in.
# .env.test is covered by the `.env*` rule in .gitignore. Never commit it.

# --- App under test -----------------------------------------------------------
# Production build served by `npm run preview`. Port 5173 is the DEV server —
# do not benchmark or audit against it, its numbers are ~10x inflated.
E2E_BASE_URL=

# --- Supabase -----------------------------------------------------------------
# Same project as codebase/.env — copy the values across.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# service_role key: Supabase dashboard -> Project Settings -> API -> service_role.
# Bypasses ALL row level security. Used only by scripts/qa-bootstrap.mjs and by
# database-integrity tests. Never import this into src/. Never print it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Test identities ----------------------------------------------------------
# Admin: the existing seeded owner account. Set the password you assigned it.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Student A / B / banned: created automatically by `npm run qa:bootstrap`.
# Pick any password meeting the app's rule (8+ chars, at least one letter and one digit).
# The emails below must stay on @kgpian.iitkgp.ac.in — the DB has a CHECK constraint.
E2E_STUDENT_PASSWORD=

E2E_STUDENT_A_EMAIL=
E2E_STUDENT_B_EMAIL=
E2E_BANNED_EMAIL=
